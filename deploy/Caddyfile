{$APP_SITE_ADDRESS} {
    root * /var/www/html
    encode zstd gzip

    @blocked {
        path /data/*
        path /deploy/*
        path /uploads/*
    }
    respond @blocked 403

    @hidden path_regexp hidden ^/(?:\.|.*\/\.)
    respond @hidden 404

    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
    }

    php_fastcgi app:9000
    file_server
}
